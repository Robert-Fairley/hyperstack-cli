{
  "name": "hstack",
  "version": "1.0.2",
  "description": "HyperStack CLI - Manage GPU instances, VMs, and tunnels",
  "main": "dist/cli.js",
  "bin": {
    "hstack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:clean": "rm -rf dist",
    "docs": "typedoc && node -e \"require('node:fs').writeFileSync('docs/.nojekyll', '')\"",
    "docs:serve": "python3 scripts/serve-docs.py",
    "docs:clean": "rm -rf ./docs",
    "hstack": "node ./dist/cli",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "hyperstack",
    "gpu",
    "cli",
    "cloud",
    "vm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Robert-Fairley/hyperstack-cli"
  },
  "engines": {
    "node": ">=20"
  },
  "author": {
    "name": "Robert Fairley",
    "email": "rob@hyperstack.cloud"
  },
  "type": "module",
  "devDependencies": {
    "@clean-jsdoc-theme/typedoc": "^5.3.0",
    "@types/node": "^26.6.6",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
